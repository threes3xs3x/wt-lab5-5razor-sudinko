@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container py-5">
    <div class="p-5 mb-4 bg-light rounded-4 shadow-sm">
        <h1 class="display-5 fw-bold">Система управления рейсами</h1>
        <p class="fs-5 text-muted">
            Веб-приложение авиакомпании на ASP.NET Core Razor Pages
        </p>
        <a asp-page="/Flights/Index" class="btn btn-primary btn-lg">Перейти к рейсам</a>
    </div>

    <div class="card shadow-sm rounded-4">
        <div class="card-body">
            <h5 class="card-title">О приложении</h5>
            <p class="card-text">
                                Здесь можно смотреть список рейсов, добавлять новые, смотреть подробную информацию и удалять рейсы.
            </p>
        </div>
    </div>
</div>
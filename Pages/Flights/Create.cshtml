@page
@model CreateModel
@{
    ViewData["Title"] = "Добавить рейс";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h1 class="fw-bold mb-4">Добавить рейс</h1>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Flight.Number" class="form-label">Номер рейса</label>
                            <input asp-for="Flight.Number" class="form-control" />
                            <span asp-validation-for="Flight.Number" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Flight.From" class="form-label">Откуда</label>
                            <input asp-for="Flight.From" class="form-control" />
                            <span asp-validation-for="Flight.From" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Flight.To" class="form-label">Куда</label>
                            <input asp-for="Flight.To" class="form-control" />
                            <span asp-validation-for="Flight.To" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Flight.Price" class="form-label">Цена</label>
                            <input asp-for="Flight.Price" class="form-control" />
                            <span asp-validation-for="Flight.Price" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-4">
                            <input asp-for="Flight.IsAvailable" class="form-check-input" />
                            <label asp-for="Flight.IsAvailable" class="form-check-label">Доступен</label>
                        </div>

                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Назад</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
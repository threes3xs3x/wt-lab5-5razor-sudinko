@page
@model DeleteModel
@{
    ViewData["Title"] = "Удаление рейса";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4 border-danger">
                <div class="card-body p-4">
                    <h1 class="fw-bold mb-3">Удалить рейс?</h1>
                    <p class="fs-5">
                        Рейс <strong>@Model.Flight!.Number</strong>:
                        @Model.Flight.From → @Model.Flight.To
                    </p>

                    <form method="post" asp-route-id="@Model.Flight.Id">
                        <button type="submit" class="btn btn-danger">Да, удалить</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Отмена</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@page
@model IndexModel
@{
    ViewData["Title"] = "Рейсы";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог рейсов</h1>
            <p class="text-muted">Количество рейсов: @Model.Flights.Count</p>
        </div>
        <a asp-page="/Flights/Create" class="btn btn-primary">Добавить</a>
    </div>

    <div class="row g-4">
        @foreach (var flight in Model.Flights)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @flight.Id</span>
                        @if (flight.IsAvailable)
                        {
                            <span class="badge bg-success mb-2">Доступен</span>
                        }
                        else
                        {
                            <span class="badge bg-danger mb-2">Недоступен</span>
                        }
                        <h5 class="card-title">Рейс @flight.Number</h5>
                        <p class="text-muted">@flight.From → @flight.To</p>
                        <p class="fs-4 fw-bold">@flight.Price руб.</p>
                        <a asp-page="/Flights/Details" asp-route-id="@flight.Id" class="btn btn-outline-primary">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>